# Local dev secrets — Tier 2 direnv pattern
#
# Real secrets live OUTSIDE the repo at:
#   ~/.local/share/secrets/ergoblock.env  (mode 600, dir mode 700)
#
# The committed .envrc auto-loads that file via direnv. To set up:
#   1. mkdir -p ~/.local/share/secrets && chmod 700 ~/.local/share/secrets
#   2. cp .env.example ~/.local/share/secrets/ergoblock.env
#   3. chmod 600 ~/.local/share/secrets/ergoblock.env
#   4. Fill in real values
#   5. direnv allow .
#
# CI/CD (release.yml) supplies these via GitHub Actions secrets — not via this file.

# Chrome Web Store API credentials (for automated publishing)
# See PUBLISHING.md for setup instructions
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=
CWS_REFRESH_TOKEN=
CWS_EXTENSION_ID=

# Firefox AMO API credentials (for automated publishing)
# Generate at https://addons.mozilla.org/en-US/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
